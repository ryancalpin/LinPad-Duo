#include "iOS.xcconfig"

PRODUCT_NAME = iSH
PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER)
INFOPLIST_FILE = app/Info.plist
// Home-screen name (CFBundleDisplayName / CFBundleName); PRODUCT_NAME stays the file name.
APP_DISPLAY_NAME = $(PRODUCT_NAME)
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREFIX_HEADER = $(BUILT_PRODUCTS_DIR)/infoplisticons.h
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// With a paid Apple Developer account, use app/iSH-MoreMemory.entitlements instead: it adds
// increased-memory-limit, so iOS lets LinPad use more of the phone's memory before closing it.
// A free account cannot sign that entitlement, so it is not the default.
// Pick it with LINPAD_ENTITLEMENTS on the xcodebuild command line: setting
// CODE_SIGN_ENTITLEMENTS there would also apply it to every Swift package target.
LINPAD_ENTITLEMENTS = app/iSH.entitlements
CODE_SIGN_ENTITLEMENTS = $(LINPAD_ENTITLEMENTS)

HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT) $(SRCROOT)/deps/libarchive/libarchive
// AccessibilityFixes.m contains a static constructor that we don't want removed
OTHER_LDFLAGS = -ObjC $(LINUX_APP_LDFLAGS) -u _accessibilityfixes_init
